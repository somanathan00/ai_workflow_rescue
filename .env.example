# Used by docker compose (host-side overrides); the app containers get their
# DATABASE_URL / REDIS_URL from docker-compose.yml.
JWT_SECRET_KEY=replace-with-a-random-secret-before-using-auth
REDIS_HOST_PORT=6380
POSTGRES_HOST_PORT=5433

# For running the app outside Docker (against the published ports above)
DATABASE_URL=postgresql+psycopg://workflow:workflow@localhost:5433/workflow_db
REDIS_URL=redis://localhost:6380/0

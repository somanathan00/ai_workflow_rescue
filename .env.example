# Used by docker compose (host-side overrides); the app containers get their
# DATABASE_URL / REDIS_URL from docker-compose.yml.
JWT_SECRET_KEY=replace-with-a-random-secret-before-using-auth
# development | test | production. Production requires a 32+ character
# JWT_SECRET_KEY and disables failure injection.
ENVIRONMENT=development
# Used by `make seed` (required in production, min 12 characters).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
REDIS_HOST_PORT=6380
POSTGRES_HOST_PORT=5433

# For running the app outside Docker (against the published ports above)
DATABASE_URL=postgresql+psycopg://workflow:workflow@localhost:5433/workflow_db
REDIS_URL=redis://localhost:6380/0
FRONTEND_PORT=3000
